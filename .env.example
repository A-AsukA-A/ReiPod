# Public browser configuration. Never use VITE_ for a .p8 private key.
VITE_APPLE_MUSIC_DEVELOPER_TOKEN=
# Optional HTTPS endpoint returning {"developerToken":"signed JWT"}.
VITE_APPLE_MUSIC_TOKEN_URL=

# Used ONLY by node scripts/apple-music-token.mjs / CI, never by Vite:
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_FILE=
APPLE_MUSIC_ORIGINS=https://a-asuka-a.github.io
