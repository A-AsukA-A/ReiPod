{
  "manifest_version": 3,
  "name": "ReiPod Music Bridge",
  "version": "0.1.2",
  "description": "为 ReiPod 提供本机浏览器内的网易云与 QQ 音乐连接，无需 HTTP 后端。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "webRequest"
  ],
  "host_permissions": [
    "https://music.163.com/*",
    "https://interface.music.163.com/*",
    "https://interface3.music.163.com/*",
    "https://qrcode.music.163.com/*",
    "https://u.y.qq.com/*",
    "https://c.y.qq.com/*",
    "https://c6.y.qq.com/*",
    "https://y.qq.com/*",
    "https://ssl.ptlogin2.qq.com/*",
    "https://xui.ptlogin2.qq.com/*",
    "https://ptlogin2.qq.com/*",
    "https://graph.qq.com/*",
    "https://open.weixin.qq.com/*",
    "https://lp.open.weixin.qq.com/*",
    "https://login.weixin.qq.com/*",
    "https://api.tencentmusic.com/*",
    "https://y.gtimg.cn/*",
    "https://interfacepc.music.163.com/*",
    "https://ssl.ptlogin2.graph.qq.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://a-asuka-a.github.io/ReiPod/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
