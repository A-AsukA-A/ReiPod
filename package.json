{
  "name": "reipod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "vitest run",
    "test:audio": "node scripts/create-test-audio.mjs",
    "phone": "node scripts/phone.mjs",
    "ios:prepare": "npm run build && node scripts/check-dist.mjs && node scripts/prepare-ios.mjs && npm run bridge:build",
    "music:serve": "node server/index.mjs",
    "test:music-server": "npm --prefix server test",
    "test:browser": "npm run build && playwright test",
    "size": "node scripts/bundle-report.mjs",
    "bridge:build": "node scripts/build-music-bridge.mjs --ios"
  },
  "dependencies": {
    "@yakult-green-tea/qq-music-api": "3.3.5",
    "crypto-js": "4.2.0",
    "music-metadata": "12.3.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
